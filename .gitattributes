# Keep parity-sensitive text stable across Windows and Linux checkouts.
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.pdf binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.mp4 binary
