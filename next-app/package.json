{
  "name": "the-wine-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:laragon": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start",
    "start:laragon": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/modules/**/*.{ts,tsx}\" \"src/providers/**/*.{ts,tsx}\" \"src/lib/**/*.{ts,tsx}\" \"src/app/reservas/**/*.{ts,tsx}\" \"src/app/admin/**/*.{ts,tsx}\" \"src/app/api/reservations/**/*.{ts,tsx}\" \"src/app/api/admin/**/*.{ts,tsx}\" \"src/app/api/payments/**/*.{ts,tsx}\" \"src/app/api/webhooks/**/*.{ts,tsx}\" \"src/components/ui/**/*.{ts,tsx}\" \"src/components/admin/**/*.{ts,tsx}\" \"src/components/reservation/v2/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "setup:reservation-foundation": "node scripts/install-reservation-foundation.mjs",
    "setup:reservation-foundation:dry-run": "node scripts/install-reservation-foundation.mjs --dry-run",
    "verify:complexity": "node scripts/check-complexity.mjs src/modules src/providers src/lib src/app/reservas src/app/admin src/app/api/reservations src/app/api/admin src/app/api/payments src/app/api/webhooks src/components/ui src/components/admin src/components/reservation/v2",
    "verify:complexity:all": "node scripts/check-complexity.mjs src",
    "verify:architecture": "node scripts/check-architecture.mjs",
    "verify:lockfile": "node scripts/check-lockfile-sync.mjs",
    "verify:guardrails": "npm run test && npm run verify:lockfile && npm run verify:complexity && npm run verify:architecture",
    "verify:foundation:preflight": "npm run test && npm run verify:lockfile && npm run verify:complexity && npm run verify:architecture && npm run setup:reservation-foundation:dry-run",
    "verify:foundation": "npm run typecheck && npm run test && npm run verify:lockfile && npm run verify:complexity && npm run verify:architecture && npm run lint && npm run verify:legacy && npm run build",
    "verify:legacy": "node scripts/verify-legacy-parity.mjs",
    "verify": "npm run typecheck && npm run test && npm run verify:legacy",
    "verify:local": "npm run typecheck && npm test && npm run verify:legacy && npm run build",
    "test:browser": "playwright test",
    "test:functional": "playwright test tests/browser/functional-parity.spec.ts",
    "test:visual": "playwright test tests/browser/visual-parity.spec.ts",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.6",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^12.43.0",
    "mysql2": "^3.24.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-sonarjs": "^3.0.7",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "postcss": "^8.5.26",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  }
}
