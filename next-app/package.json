{
  "name": "the-wine-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:laragon": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start",
    "start:laragon": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify:complexity": "node scripts/check-complexity.mjs",
    "verify:legacy": "node scripts/verify-legacy-parity.mjs",
    "verify": "npm run typecheck && npm run test && npm run verify:legacy",
    "verify:local": "npm run typecheck && npm test && npm run verify:legacy && npm run build",
    "test:browser": "playwright test",
    "test:functional": "playwright test tests/browser/functional-parity.spec.ts",
    "test:visual": "playwright test tests/browser/visual-parity.spec.ts",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "mysql2": "^3.24.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^24.0.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3"
  }
}
